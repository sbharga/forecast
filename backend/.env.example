# Copy this to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Local:   postgresql://postgres:password@localhost:5432/scope
# Render:  postgresql://user:pass@dpg-xxxx.oregon-postgres.render.com/scope
# Railway: postgresql://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/scope

# ── Future workers ────────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_IDS=123456789,987654321
# GEMINI_API_KEY=
# GMAIL_CREDENTIALS_PATH=./credentials.json
# GMAIL_LABEL=Scope
