# Copy this to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Local:   postgresql://postgres:password@localhost:5432/scope
# Render:  postgresql://user:pass@dpg-xxxx.oregon-postgres.render.com/scope
# Railway: postgresql://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/scope

# ── Discord / Gemini ──────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
GEMINI_API_KEY=

# ── Google OAuth (Web Application client) ────────────────────────────────
# Create a Web Application OAuth client in Google Cloud Console.
# Add https://auth.expo.io/@YOUR_EXPO_USERNAME/scope as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JWT sessions ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_DAYS=30
